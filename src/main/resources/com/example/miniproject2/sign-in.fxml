<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<GridPane fx:controller="com.example.miniproject2.SignInController" xmlns:fx="http://javafx.com/fxml" alignment="center" hgap="10" vgap="10">
    <Label text="Company Management System" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2">
        <font>
            <Font size="22.0" />
        </font>
        <GridPane.margin>
            <Insets bottom="15.0" />
        </GridPane.margin>
    </Label>

    <Label text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextField fx:id="usernameField" promptText="admin" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <PasswordField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <!-- defaultButton: pressing Enter also signs in -->
    <Button text="Sign In" fx:id="signInButton" defaultButton="true" onAction="#handleSignIn" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <!-- Shows "Invalid username or password" etc. -->
    <Label fx:id="errorLabel" textFill="red" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" />
</GridPane>
